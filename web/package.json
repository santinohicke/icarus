{
  "name": "icarus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Icarus web front-end: land a rocket first stage by hand.",
  "scripts": {
    "wasm": "cargo build -p icarus-wasm --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/wasm ../target/wasm32-unknown-unknown/release/icarus_wasm.wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run wasm",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.19.2",
    "@types/topojson-client": "3.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "d3-geo": "3.1.2",
    "topojson-client": "3.1.0",
    "uplot": "1.6.32",
    "world-atlas": "2.0.2"
  }
}
